{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/api/results.php", "destination": "/api/results.php" },
    { "source": "/api/multiple_key.php", "destination": "/api/multiple_key.php" },
    { "source": "/(.*)", "destination": "/index.php" }
  ]
}
